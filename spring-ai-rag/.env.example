# 环境变量示例。application.yml 会尝试导入项目根目录的 .env（已在 .gitignore），
# 把本文件复制为 .env 并填好值即可；也可以用 shell / IDE Run Configuration 覆盖。
# 不要把真实 Key 提交到 git。

# 对话：内网模型网关（OpenAI 兼容协议）
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=http://your-gateway.example.com
ANTHROPIC_MODEL=deepseek-v4-flash
CHAT_MAX_TOKENS=2048

# Embedding：任意 OpenAI 兼容服务，默认硅基流动 bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn
EMBEDDING_MODEL=BAAI/bge-m3
# 必须与模型输出维度一致（bge-m3=1024）
EMBEDDING_DIMENSION=1024

# MySQL（application-local.yml 默认 root/123456；使用 docker compose 时端口为 13306）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=springai_rag
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USERNAME=root
MILVUS_PASSWORD=Milvus
MILVUS_DATABASE=default

# Redis：JWT 会话、注销与在线人数（本地默认 localhost:6379；
# 使用 docker compose 时可设为 16379）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# JWT：至少 32 字节的随机字符串，生产环境必须修改
JWT_SECRET=xinli-demo-jwt-secret-please-change-in-production-2026
JWT_TTL=7d
AUTH_ONLINE_WINDOW=15m
